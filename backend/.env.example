# Database Configuration (Defaults to SQLite; PostgreSQL connection string for production)
DATABASE_URL=sqlite:///./spaceguard.db
# DATABASE_URL=postgresql://spaceguard:spaceguard_pass@localhost:5432/spaceguard_db

# Security & CORS
SECRET_KEY=spaceguard-super-secret-key-change-in-prod
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Storage Dirs
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports

# ML Screening Parameters
RISK_SAFE_MAX=35.0
RISK_MONITOR_MAX=70.0
LOT_ZSCORE_THRESHOLD=2.5
PREDICTION_HORIZON_HOURS=250.0
